#!/usr/bin/env python3
"""Start one round of the last successfully deployed vision package.

`start --show` only prints the selection; it never contacts the car.
Each normal invocation uses start-round.py's existing fresh evidence directory.
"""
import json
import os
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
WORK = ROOT / 'work/vehicle-dynamic-deploy-20261008'


def deployed_round():
    deployments = sorted(WORK.glob('claude-turn*-deployment-result.json'),
                         key=lambda p: p.stat().st_mtime, reverse=True)
    for path in deployments:
        deployment = json.loads(path.read_text())
        if not deployment.get('deployed'):
            continue
        package_name = path.name.replace('-deployment-result.json', '-package.json')
        for vision in WORK.glob('claude-y*-package.json'):
            package = json.loads(vision.read_text())
            if (package.get('base_package') == package_name
                    and package.get('source_commit') == deployment['source_commit']):
                return package['label'].removeprefix('claude-')
        raise SystemExit('最近部署的引擎还没有匹配的视觉助手，请先完成助手部署。')
    raise SystemExit('没有成功部署的本地记录。')


if __name__ == '__main__':
    if sys.argv[1:] not in ([], ['--show']):
        raise SystemExit('用法：start（发车一轮）或 start --show（只看版本）')
    label = deployed_round()
    if sys.argv[1:] == ['--show']:
        print(label)
    else:
        os.execv(sys.executable, [sys.executable, '-B', str(ROOT / 'scripts/start-round.py'), label])
