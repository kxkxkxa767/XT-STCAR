  "real_turning_controller_regression": {
    "test": "real_turning_controller_respects_actual_adoption_curvature_spacing",
    "source": "crates/runner/tests/async_deadlines.rs",
    "last_actual_adoption_ms": 190,
    "current_planned_at_ms": 200,
