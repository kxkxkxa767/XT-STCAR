  "contract": {
    "record": "AtomicExecution 同一 seqlock snapshot 的最新 changed-command record；latest steering.at 只表示最新 poll/model 时刻。",
    "changes_that_reset_clock": [
      "曲率目标变化",
      "仅速度目标变化",
      "Stop 与 Drive 之间的变化，包括零速度零曲率 Drive"
    ],
    "unchanged_commands": "重复完全相同的命令不改变 revision/last_command_change_at。",
    "candidate_and_certificate": "held curvature ± rate*(planned_at-last_command_change_at)，交绝对曲率范围；从采用窗起点即可满足 slew。",
    "bootstrap": "仅 revision=0 + None，held speed/commanded/applied/history curvature 全零；初次允许原 control_period_ms 对应曲率变化。",
    "output_poll": "仍按实际 now、同一 revision 的最后真实命令变化时刻独立复核；BeforeWindow/AfterWindow/ExecutionChanged/lease/fault 规则保持。",
    "forecast": "保留当前真实 last-change 相对计划起点的秒时钟；三采用样本含半毫秒而不取整，模型每次速度或曲率目标变化更新该时钟，未来计划/采用均检查；原 source 的 history V/K 不重置。",
    "invalid_inputs": "缺失或未来 change stamp、stamp/revision 不一致、非零 bootstrap steering、nonfinite/negative rate 与计算溢出均 fail closed。"
  },
